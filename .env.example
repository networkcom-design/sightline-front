# Copiar a .env para desarrollo local, o cargar en el panel de Netlify.
#
# Sin esta variable el frontend apunta a http://localhost:8080, que es lo que
# se quiere en desarrollo. En Netlify hay que definirla con la direccion del
# backend en Render, sin barra al final.
VITE_API_URL=https://sightline-api.onrender.com
